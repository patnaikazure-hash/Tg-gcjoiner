<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bypass.growwkyc">

    <application
        android:label="Groww KYC Bypass"
        android:allowBackup="false"
        android:hasCode="true">

        <!-- Tells LSPosed/Xposed this is a module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="Bypasses Groww KYC gate so you can view stocks without KYC" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <!-- LSPosed scope hint (optional but helpful) -->
        <meta-data
            android:name="xposedscope"
            android:value="in.groww.stocks" />

    </application>

</manifest>
