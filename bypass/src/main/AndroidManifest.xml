<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bypass.growwkyc">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:label="Groww KYC Bypass"
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@android:drawable/ic_menu_view"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Tells LSPosed/Xposed this is a module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="Bypasses Groww KYC gate so you can view stocks without KYC" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <!-- LSPosed scope hint (optional but helpful) -->
        <meta-data
            android:name="xposedscope"
            android:value="in.groww.stocks" />

        <!-- Log viewer Activity — tap the app icon to open it -->
        <activity
            android:name=".LogViewerActivity"
            android:label="KYC Bypass Logs"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
